{
  "name": "life_tracking_api",
  "version": "0.1.0",
  "description": "A simple activity tracking api.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch './src/**/*.ts' --watch './src/*.ts' --exec 'ts-node -r tsconfig-paths/register ./src/index.ts'",
    "build": "tsc && tsc-alias",
    "start": "node ./dist/index.js"
  },
  "keywords": [
    "activity tracking",
    "journal"
  ],
  "author": "Daniel Langio",
  "license": "ISC",
  "packageManager": "pnpm@10.7.1",
  "devDependencies": {
    "nodemon": "^3.1.9",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "postgres": "^3.4.5",
    "tsc-alias": "^1.8.13"
  }
}
